# Copy this to .env and fill in values
# Never commit .env to git

# ─── Database ─────────────────────────────────────────────────────────────
# Local Docker Postgres (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://certiflow:certiflow@localhost:5432/certiflow

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-32-char-secret-in-production
JWT_EXPIRES_IN=7d

# ─── MinIO (local S3-compatible storage) ──────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=certiflow
MINIO_USE_SSL=false

# ─── Mock WhatsApp ────────────────────────────────────────────────────────
WHATSAPP_MOCK_URL=http://localhost:4000

# ─── App ──────────────────────────────────────────────────────────────────
PORT=3000
STORAGE_TYPE=local   # local (dev) or s3 (prod with MinIO/AWS)
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
