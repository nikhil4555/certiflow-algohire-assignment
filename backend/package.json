{
  "name": "certiflow-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker-entry.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-entry.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.540.0",
    "@aws-sdk/s3-request-presigner": "3.540.0",
    "@prisma/client": "5.11.0",
    "axios": "^1.21.1",
    "bcryptjs": "2.4.3",
    "bullmq": "5.4.2",
    "cors": "2.8.5",
    "csv-parse": "5.5.5",
    "dotenv": "^18.0.10",
    "express": "4.18.3",
    "express-rate-limit": "7.2.0",
    "helmet": "7.1.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "minio": "7.1.3",
    "multer": "1.4.5-lts.1",
    "nanoid": "3.3.7",
    "pdfkit": "0.14.0",
    "pino": "8.19.0",
    "pino-pretty": "11.0.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "1.4.11",
    "@types/node": "20.11.30",
    "@types/pdfkit": "0.13.4",
    "jest": "29.7.0",
    "prisma": "5.11.0",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.3"
  }
}
